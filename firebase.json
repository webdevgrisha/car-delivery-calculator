{
  "firestore": {
    "rules": "firestore.rules"
  },
  "database": {
    "rules": "database.rules.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "pnpm --dir \"$RESOURCE_DIR\" run lint",
        "pnpm --dir \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "emulators": {
    "auth": {
      "host": "127.0.0.1",
      "port": 9199
    },
    "functions": {
      "host": "127.0.0.1",
      "port": 5101
    },
    "firestore": {
      "host": "127.0.0.1",
      "port": 8180,
      "websocketPort": 9160
    },
    "database": {
      "host": "127.0.0.1",
      "port": 9100
    },
    "ui": {
      "enabled": true,
      "host": "127.0.0.1",
      "port": 4100
    },
    "hub": {
      "host": "127.0.0.1",
      "port": 4410
    },
    "logging": {
      "host": "127.0.0.1",
      "port": 4510
    },
    "singleProjectMode": true
  }
}
