{
  "name": "functions",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "pnpm run build && firebase emulators:start --only functions",
    "seed:emulators": "node scripts/seedEmulators.cjs",
    "shell": "pnpm run build && firebase functions:shell",
    "start": "pnpm run shell",
    "lint:fix": "eslint . --fix",
    "deploy": "pnpm run lint:fix && firebase deploy",
    "logs": "firebase functions:log",
    "postinstall": "puppeteer browsers install chrome",
    "gcp-build": "node node_modules/puppeteer/install.mjs"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@google-cloud/secret-manager": "^5.6.0",
    "axios": "^1.7.7",
    "cheerio": "^1.0.0",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.1.0",
    "puppeteer": "^23.10.4",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-proxy": "^1.0.2",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^5.12.0",
    "@typescript-eslint/parser": "^5.12.0",
    "eslint": "^8.9.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "firebase-functions-test": "^3.3.0",
    "typescript": "^4.9.0"
  },
  "private": true,
  "packageManager": "pnpm@10.33.4"
}
